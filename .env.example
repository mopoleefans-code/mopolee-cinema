# MOPOLEE CINEMA & EXCHANGE - Paystack Configuration
# NOTE: Frontend Android uses PAYSTACK_PUBLIC_KEY and calls your secure backend.
# The PAYSTACK_SECRET_KEY must NEVER be in this file or inside the Android client!

# Paystack Public Key
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY_PLACEHOLDER

# Secure Backend Verification Server URL (Node.js or Python backend)
# Example: https://your-backend.onrender.com or http://10.0.2.2:5000 (Android Emulator localhost)
PAYSTACK_BACKEND_URL=https://mopolee-paystack-backend.onrender.com
