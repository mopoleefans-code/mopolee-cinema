# Paystack Secret Key
# CRITICAL: Keep this secret! Never share or commit this to public git.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY_PLACEHOLDER

# Paystack Public Key (for reference/matching)
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY_PLACEHOLDER

# Server Port
PORT=5000

# Optional: Allowed CORS origin for web dashboard (or * for mobile)
CORS_ORIGIN=*
